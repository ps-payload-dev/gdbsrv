PLATFORM := ps4
PS4_HOST ?= ps4
PS4_PORT ?= 9021

ifndef PS4_PAYLOAD_SDK
$(error PS4_PAYLOAD_SDK is undefined)
endif
include $(PS4_PAYLOAD_SDK)/toolchain/orbis.mk

BIN := build/ps4/gdbsrv-ps4.elf
SRCS := gdb_serve.c gdb_resp.c gdb_sig.c gdb_pkt.c
SRCS += main.c gdb_arch.c pt.c elfldr.c
VERSION_TAG := $(shell git describe --abbrev=6 --dirty --always --tags)
CFLAGS := -Iheaders -Iheaders/ps4 -Wall -DVERSION_TAG=\"$(VERSION_TAG)\"

include Makefile.build

test: $(BIN)
	$(PS4_DEPLOY) -h $(PS4_HOST) -p $(PS4_PORT) $<
