PLATFORM := linux
LINUX_HOST ?= localhost
BIN := build/linux/payload-linux.elf
CFLAGS := -Wall -Werror -g -static

include Makefile.build

test: $(BIN)
	gdb \
	-ex "target extended-remote $(LINUX_HOST):2159" \
	-ex "file $(BIN)" \
	-ex "remote put $(BIN) /tmp/$(notdir $(BIN))" \
	-ex "set remote exec-file /tmp/$(notdir $(BIN))" \
	-ex "start"
