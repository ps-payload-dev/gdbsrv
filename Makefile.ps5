PLATFORM := ps5
PS5_HOST ?= ps5
PS5_PORT ?= 9021

ifndef PS5_PAYLOAD_SDK
$(error PS5_PAYLOAD_SDK is undefined)
endif
include $(PS5_PAYLOAD_SDK)/toolchain/prospero.mk

BIN := build/ps5/gdbsrv-ps5.elf
SRCS := gdb_serve.c gdb_resp.c gdb_sig.c gdb_pkt.c
SRCS += main.c gdb_arch.c pt.c elfldr.c
VERSION_TAG := $(shell git describe --abbrev=6 --dirty --always --tags)
CFLAGS := -Iheaders -Iheaders/ps5 -Wall -DVERSION_TAG=\"$(VERSION_TAG)\"

include Makefile.build

test: $(BIN)
	$(PS5_DEPLOY) -h $(PS5_HOST) -p $(PS5_PORT) $<
