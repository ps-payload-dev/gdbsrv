PLATFORM := ps4
PS4_HOST ?= ps4
ifndef PS4_PAYLOAD_SDK
$(error PS4_PAYLOAD_SDK is undefined)
endif
include $(PS4_PAYLOAD_SDK)/toolchain/orbis.mk

BIN := build/ps4/payload-ps4.elf
CFLAGS := -Wall -Werror -g

include Makefile.build

test: $(BIN)
	gdb-multiarch \
	-ex "set architecture i386:x86-64" \
	-ex "target extended-remote $(PS4_HOST):2159" \
	-ex "file $(BIN)" \
	-ex "remote put $(BIN) /user/temp/$(notdir $(BIN))" \
	-ex "set remote exec-file /user/temp/$(notdir $(BIN))" \
	-ex "start"
